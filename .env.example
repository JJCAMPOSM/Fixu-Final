# Copiar como .env en cada servidor (nunca commitear el .env real)
DB_PASSWORD=cambia-esta-password
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
JWT_SECRET_KEY=cambia-esta-clave-jwt-larga-y-aleatoria
HMAC_SECRET_KEY=cambia-esta-clave-hmac
INTERNAL_API_KEY=cambia-esta-api-key-interna

# Cifrado simétrico (Fernet) de campos sensibles en reposo (ej. teléfono del
# solicitante). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=cambia-esta-clave-fernet-generada-con-el-comando-de-arriba

# IP/dominio público (nginx del servidor público, puerto 80) usado por Flask
# para construir URLs absolutas de fotos de tickets alcanzables desde la App Móvil
PUBLIC_BASE_URL=http://167.172.144.30
