{
  "expo": {
    "name": "Fixu Movil",
    "slug": "fixu-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f3f4f6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.fixu.movil",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.fixu.movil",
      "infoPlist": {
        "NSCameraUsageDescription": "Fixu necesita la cámara para capturar evidencia en sitio de las fallas reportadas.",
        "NSLocationWhenInUseUsageDescription": "Fixu usa tu ubicación para confirmar que el reporte se generó en el sitio de la falla."
      }
    },
    "extra": {
      "apiUrl": "http://localhost:8080"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
