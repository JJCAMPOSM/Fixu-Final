{
  "expo": {
    "name": "Fixu Campo",
    "slug": "fixu-campo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#111827"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.fixu.campo",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "ios": {
      "bundleIdentifier": "com.fixu.campo",
      "infoPlist": {
        "NSCameraUsageDescription": "Fixu necesita la cámara para adjuntar fotos de fallas a los tickets.",
        "NSPhotoLibraryUsageDescription": "Fixu necesita acceso a fotos para adjuntar imágenes a los tickets."
      }
    },
    "extra": {
      "apiUrl": "http://localhost:8080"
    }
  }
}
