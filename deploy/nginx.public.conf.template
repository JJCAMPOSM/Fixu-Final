worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    client_max_body_size 8m;

    # Reemplaza <IP_PRIVADA> por la IP privada real del servidor privado
    upstream flask_backend {
        server <IP_PRIVADA>:5001;
        server <IP_PRIVADA>:5002;
    }

    upstream bridge_backend {
        server <IP_PRIVADA>:8001;
        server <IP_PRIVADA>:8002;
    }

    upstream laravel_backend {
        server <IP_PRIVADA>:8000;
    }

    upstream grafana_backend {
        server grafana:3000;
    }

    server {
        listen 80;
        listen 443 ssl;
        server_name _;

        ssl_certificate     /etc/nginx/ssl/fixu.crt;
        ssl_certificate_key /etc/nginx/ssl/fixu.key;

        location /admin/ {
            proxy_pass http://laravel_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /grafana/ {
            proxy_pass http://grafana_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location / {
            proxy_pass http://flask_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }

    server {
        listen 8080;
        server_name _;

        location / {
            proxy_pass http://bridge_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }

    server {
        listen 8404;
        server_name _;

        location /nginx_status {
            stub_status on;
            access_log off;
        }

        location / {
            return 200 'Fixu - Nginx stats en /nginx_status\n';
            add_header Content-Type text/plain;
        }
    }
}
